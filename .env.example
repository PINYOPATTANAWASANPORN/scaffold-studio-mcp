# Stellar Studio MCP Server - Environment Configuration Template
# Copy this file to .env and fill in your credentials:
#   cp .env.example .env
#
# Never commit real secret keys to version control.

# Stellar Secret Key (Required, starts with S...)
# Generate a new testnet keypair with Stellar CLI:
#   stellar keys generate my-account --network testnet --fund
#   stellar keys secret my-account
STELLAR_SECRET_KEY=SXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX

# Stellar Network (Optional: local | testnet | mainnet, defaults to local)
STELLAR_NETWORK=testnet
